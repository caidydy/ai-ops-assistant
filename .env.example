# 应用配置
APP_NAME=ai-ops-assistant
DEBUG=True
HOST=0.0.0.0
PORT=9900

# DashScope 配置（必填，替换为你自己的 API Key）
# 获取地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3
RAG_MODEL=qwen-max

# 重排（Rerank）配置：召回后使用百炼重排模型对文档相关性重新排序
# RERANK_ENABLED=false 可关闭重排（退化回纯向量召回）
RERANK_ENABLED=true
# 百炼重排模型（gte-rerank 已于 2026-05-30 下线，官方推荐 qwen3-rerank）
RERANK_MODEL=qwen3-rerank
# 向量召回窗口：先召回 N 条候选，重排后只保留前 RAG_TOP_K 条
RERANK_RETRIEVE_K=6

# 混合检索（Hybrid Search）配置：向量（余弦相似度）+ BM25 词法检索，RRF 融合
# HYBRID_SEARCH_ENABLED=false 可关闭（退化回纯向量召回）
HYBRID_SEARCH_ENABLED=true
# BM25 召回窗口：与 RERANK_RETRIEVE_K 对齐，融合前各取 N 条
BM25_RETRIEVE_K=6
# RRF 融合常数（业界标准值 60，控制排名权重衰减）
RRF_K=60

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 支持的 transport 类型：stdio、sse（腾讯云等 /sse/ 端点）、streamable-http（本地 FastMCP）
# ---- 本地 mock CLS（mcp_servers/cls_server.py，含模拟告警 + 日志，推荐演示）----
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8383/mcp
# ---- 方案一：腾讯云 CLS MCP（自建 npx cls-mcp-server，SSE，真实云端告警）----
# 先在 mcp_servers 目录执行 start-cls-mcp.bat（或 npx -y cls-mcp-server@latest）
# MCP_CLS_TRANSPORT=sse
# MCP_CLS_URL=http://localhost:3000/sse

MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8384/mcp

# Prometheus（告警查询工具等；方案一关闭，避免 Agent 优先请求本机 9090）
PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10.0
ENABLE_PROMETHEUS_ALERTS=false